// Cupido Algorítmico · configuración de Cloudflare — RLR
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cupido-algoritmico",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-14",
  "workers_dev": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/articulos", "/articulos/*", "/docs/*", "/demo", "/demo.html"]
  },
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "d1_databases": [
    { "binding": "DB", "database_name": "cupido-db", "database_id": "02afb8ad-7fca-4c16-ab28-66540173139d" }
  ]
}
