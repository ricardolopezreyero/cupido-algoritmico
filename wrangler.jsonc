// Cupido Algorítmico · configuración de Cloudflare — RLR
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cupido-algoritmico",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-14",
  "workers_dev": true,
  "routes": [{ "pattern": "cupido.capitaltorreon.com", "custom_domain": true }],
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/articulos", "/articulos/*", "/docs/*", "/demo", "/demo.html", "/entrar/*", "/persona", "/cuestionario", "/i/*", "/correo/*"]
  },
  // Correo: FROM_EMAIL aquí; la llave va en secrets (wrangler secret put RESEND_KEY)
  // ADMINES: huellas (no correos) de las cuentas que pueden ver el detalle de los reportes y retirar a alguien. Se calculan con huella() de src/ella.js.
  "vars": { "FROM_EMAIL": "Cupido Algorítmico <cupido@capitaltorreon.com>", "BASE_URL": "https://cupido.capitaltorreon.com", "ADMINES": "22b4416e984e66d8a380ce36261f4062,75c35f4dc0cfba67b63601dcba973408" },
  // 0 16 * * * = cada día a las 10 de la mañana (centro de México): recordatorios y, los domingos, el resumen. */3 = juntar y mandar las novedades de las charlas.
  "triggers": { "crons": ["0 16 * * *", "*/3 * * * *"] },
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "ai": { "binding": "AI" },
  // La llave de Stripe vive UNA vez en la bóveda de la cuenta (Secrets Store «superleads»); aquí solo se liga. Cuando llegue la de CapitalTorreon se cambia el secret_name.
  "secrets_store_secrets": [
    { "binding": "STRIPE_SECRET_KEY", "store_id": "308dac6355cb4d7a8bef6cc8ef7ee035", "secret_name": "STRIPE_SECRET_KEY" },
    { "binding": "ELEVENLABS_API_KEY", "store_id": "308dac6355cb4d7a8bef6cc8ef7ee035", "secret_name": "ELEVENLABS_API_KEY" }
  ],
  "r2_buckets": [{ "binding": "MEDIOS", "bucket_name": "cupido-medios" }],
  "durable_objects": { "bindings": [{ "name": "CHARLA_VIVA", "class_name": "CharlaViva" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CharlaViva"] }],
  "d1_databases": [
    { "binding": "DB", "database_name": "cupido-db", "database_id": "02afb8ad-7fca-4c16-ab28-66540173139d" }
  ]
}
